# syntax=docker/dockerfile:1
# CI resolves the candidate tag to one immutable manifest before both test matrices.
ARG PYTHON_BASE=python:3.11-slim-trixie
FROM ${PYTHON_BASE} AS patched
# Apply signed Debian updates through the normal package manager; retain dpkg metadata.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

FROM patched AS deps
WORKDIR /build
COPY backend/requirements-worker.lock.txt ./
# Install only the previously tested pinned wheels, without pip in the venv.
RUN python -m venv --without-pip /opt/venv \
    && python -m pip --python /opt/venv install --no-cache-dir --only-binary=:all: -r requirements-worker.lock.txt \
    && python -m pip --python /opt/venv check

FROM patched AS runner
WORKDIR /app
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/backend PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=Asia/Shanghai HOME=/tmp TMPDIR=/data/tmp DUCKDB_TEMP_DIRECTORY=/data/tmp/duckdb
# Global installer tooling is not required by the runtime. Remove bundled
# ensurepip wheels too, without removing OS libraries or application packages.
RUN python -m pip uninstall -y setuptools wheel pip \
    && rm -rf /usr/local/lib/python3.11/ensurepip \
    && groupadd --gid 10010 archive && useradd --uid 10002 --gid 10010 --no-create-home --shell /usr/sbin/nologin worker
COPY --from=deps /opt/venv /opt/venv
COPY backend/value_screener /app/backend/value_screener
COPY database /app/database
RUN mkdir -p /data/archive /data/tmp/duckdb && chown -R 10002:10010 /data
USER 10002:10010
ENTRYPOINT ["python","-m","value_screener.local_pipeline"]
CMD ["--help"]
