# syntax=docker/dockerfile:1
# CPython 3.13 x86_64 wheels; build and runtime use Debian 13/glibc.
# CI resolves both base digests and a wheel hash lock before building.
ARG PYTHON_BASE=python:3.13-slim-trixie
ARG WORKER_RUNTIME_BASE=gcr.io/distroless/python3-debian13:nonroot
FROM ${PYTHON_BASE} AS deps
WORKDIR /build
COPY backend/requirements-worker.cp313.hashes.txt ./requirements.lock
RUN python -m venv --without-pip /opt/venv \
    && python -m pip --python /opt/venv install --no-cache-dir --only-binary=:all: --require-hashes -r requirements.lock \
    && python -m pip --python /opt/venv check \
    && mkdir -p /opt/runtime-data/archive /opt/runtime-data/tmp/duckdb
# Copy wheel installations, not the builder's interpreter, venv symlinks,
# pip, or arbitrary system libraries. Runtime uses its own Debian Python.
FROM ${WORKER_RUNTIME_BASE} AS runner
WORKDIR /app
ENV PATH=/usr/bin:/bin PYTHONPATH=/app/backend:/opt/runtime-packages PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=Asia/Shanghai HOME=/tmp TMPDIR=/data/tmp DUCKDB_TEMP_DIRECTORY=/data/tmp/duckdb
COPY --from=deps /opt/venv/lib/python3.13/site-packages/ /opt/runtime-packages/
COPY --from=deps --chown=10002:10010 /opt/runtime-data/ /data/
COPY --chown=10002:10010 backend/value_screener /app/backend/value_screener
COPY database /app/database
USER 10002:10010
ENTRYPOINT ["/usr/bin/python3","-m","value_screener.local_pipeline"]
CMD ["--help"]
