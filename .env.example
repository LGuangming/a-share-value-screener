# Vercel only, server-side; use a dedicated PostgreSQL read-only account.
DATABASE_READ_URL=postgresql://screener_reader:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=require

# GitHub Actions only. NOT exposed to the browser.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
TUSHARE_TOKEN=YOUR_TUSHARE_PRO_TOKEN

# Tushare source selection for the Python CLI. Default remains official HTTPS.
TUSHARE_API_SOURCE=official

# Optional third-party relay test (do not enable by default).
# TUSHARE_API_SOURCE=relay
# TUSHARE_RELAY_TOKEN=YOUR_SEPARATE_RELAY_TOKEN
# TUSHARE_RELAY_URL=http://tus.sxdata.top/tu_share/
# TUSHARE_ALLOW_HTTP=1
# WARNING: HTTP relay sends the token unencrypted. Prefer HTTPS if the provider offers it.

# Optional tuning for relay 429 responses; only used in relay mode.
# TUSHARE_RELAY_MIN_INTERVAL_SECONDS=5

# 2025+ backtest Parquet archive: PRIVATE Neon Object Storage.
# Configure these in GitHub Actions (Secrets vs Variables), NOT in Vercel.
# Never commit real nak_live_/nsk_live_ credentials.
NEON_STORAGE_ENDPOINT=https://br-YOUR-BRANCH.storage.c-1.us-east-2.aws.neon.tech
NEON_STORAGE_ACCESS_KEY_ID=YOUR_SCOPED_TOKEN_ID
NEON_STORAGE_SECRET_ACCESS_KEY=YOUR_SCOPED_S3_SECRET
NEON_STORAGE_BUCKET=a-share-backtest-private
NEON_STORAGE_REGION=us-east-2
# Set true ONLY after Neon Console confirms the bucket access is PRIVATE.
NEON_STORAGE_PRIVATE_CONFIRMED=false

# Vercel server-side only: REQUIRED for website access; never use NEXT_PUBLIC_.
# Choose a strong shared password (16–512 characters) and a separate 32-byte random hex signing key.
# Missing or invalid configuration denies access; changing either invalidates old sessions.
SITE_ACCESS_PASSWORD=
SITE_SESSION_SECRET=
