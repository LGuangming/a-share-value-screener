# Copy to /opt/ashare/config/.env; do not commit actual values.
# Paths relative to /opt/ashare/app/compose.yaml or absolute.
WEB_IMAGE=ghcr.io/lguangming/a-share-value-screener-web:sha-REVIEWED_COMMIT
WORKER_IMAGE=ghcr.io/lguangming/a-share-value-screener-worker:sha-REVIEWED_COMMIT
DATABASE_NETWORK=REPLACE_WITH_VERIFIED_DATABASE_NETWORK
# Required only with compose.bridge.yaml:
# PROXY_NETWORK=REPLACE_WITH_VERIFIED_PROXY_NETWORK
# ASHARE_LOOPBACK_PORT=3000
WEB_ENV_FILE=../config/web.env
WORKER_ENV_FILE=../config/worker.env
ARCHIVE_DIR=../archive
WEB_CACHE_DIR=../cache/nextjs
WORKER_TMP_DIR=../tmp
