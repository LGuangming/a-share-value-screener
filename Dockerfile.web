# syntax=docker/dockerfile:1
# CI resolves the candidate tag to one immutable manifest before both test matrices.
ARG NODE_BASE=node:22-trixie-slim
ARG WEB_RUNTIME_BASE=gcr.io/distroless/nodejs22-debian13:nonroot
FROM ${NODE_BASE} AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM ${NODE_BASE} AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_STANDALONE=1
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json next.config.ts next-env.d.ts tsconfig.json proxy.ts ./
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY strategies ./strategies
RUN npm run typecheck && npm run build && mkdir -p public /app/runtime-cache

# Use a real minimal runtime, not a full distribution with scanner metadata removed.
FROM ${WEB_RUNTIME_BASE} AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 NODE_OPTIONS=--max-old-space-size=512 PATH=/nodejs/bin:/usr/bin:/bin
COPY --from=builder --chown=10001:10010 /app/.next/standalone ./
COPY --from=builder --chown=10001:10010 /app/.next/static ./.next/static
COPY --from=builder --chown=10001:10010 /app/public ./public
COPY --from=builder --chown=10001:10010 /app/lib/test-web-guard.cjs ./test-web-guard.cjs
COPY --from=builder --chown=10001:10010 /app/lib/test-web-launch.cjs ./test-web-launch.cjs
COPY --from=builder --chown=10001:10010 /app/runtime-cache/ ./.next/cache/
USER 10001:10010
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["/nodejs/bin/node","-e","fetch('http://127.0.0.1:3000/login',{redirect:'manual',signal:AbortSignal.timeout(3000)}).then(r=>process.exit([200,503].includes(r.status)?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["/app/server.js"]
